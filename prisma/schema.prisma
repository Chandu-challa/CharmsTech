generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Technology {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  type      String    // frontend, backend, database, ai_ml, tools
  icon      String?
  isActive  Boolean   @default(true)
  projects  Project[] @relation("ProjectTechnologies")
  courses   Course[]  @relation("CourseTechnologies")
  createdAt DateTime  @default(now())
}

model Project {
  id               String    @id @default(cuid())
  projectCode      String    @unique
  title            String
  slug             String    @unique
  degree           String
  categoryId       String
  category         ProjectCategory @relation(fields: [categoryId], references: [id])
  subcategory      String?
  difficulty       String
  shortDescription String
  description      String
  problemStatement String?
  proposedSolution String?
  objectives       String?
  duration         String?
  pricing          String?
  status           String    @default("Available")
  isFeatured       Boolean   @default(false)
  isPublished      Boolean   @default(false)
  technologies     Technology[] @relation("ProjectTechnologies")
  modules          ProjectModule[]
  features         ProjectFeature[]
  requests         ProjectRequest[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProjectModule {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleName   String
  description  String?
  displayOrder Int     @default(0)
}

model ProjectFeature {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature      String
  displayOrder Int     @default(0)
}

model Course {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  shortDescription String
  description      String
  duration         String
  level            String
  status           String    @default("Available")
  isFeatured       Boolean   @default(false)
  technologies     Technology[] @relation("CourseTechnologies")
  modules          CourseModule[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CourseModule {
  id           String  @id @default(cuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleName   String
  description  String?
  displayOrder Int     @default(0)
}

model Registration {
  id                  String   @id @default(cuid())
  registrationCode    String   @unique
  fullName            String
  mobile              String
  email               String
  college             String
  degree              String
  branch              String
  year                String
  interestType        String
  preferredCourse     String?
  preferredProject    String?
  preferredTechnology String?
  message             String?
  status              String   @default("New")
  adminNotes          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProjectRequest {
  id               String   @id @default(cuid())
  requestCode      String   @unique
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fullName         String
  mobile           String
  email            String
  college          String
  degree           String
  branch           String
  year             String
  preferredContact String
  message          String?
  status           String   @default("New")
  adminNotes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ContactEnquiry {
  id          String   @id @default(cuid())
  enquiryCode String   @unique
  name        String
  mobile      String
  email       String
  subject     String
  message     String
  status      String   @default("New")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InternshipRequest {
  id                 String   @id @default(cuid())
  requestCode        String   @unique
  fullName           String
  mobile             String
  email              String
  college            String
  degree             String
  branch             String
  year               String
  technologyInterest String
  message            String?
  status             String   @default("New")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
